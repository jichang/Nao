      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(nao_provider_call_duration_milliseconds_sum[5m])) / sum(rate(nao_provider_call_duration_milliseconds_count[5m]))",
          "refId": "A"
        }
      ],
      "title": "Provider mean latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
