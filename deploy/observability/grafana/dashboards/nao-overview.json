      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        { "expr": "sum(rate(nao_execution_count_total[5m])) by (nao_terminal_state)", "refId": "A" }
      ],
      "title": "Execution rate by terminal state",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
