<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/Model/Geometry.fs" />
    <Compile Include="src/Model/Resources.fs" />
    <Compile Include="src/Model/Styling.fs" />
    <Compile Include="src/Model/Layout.fs" />
    <Compile Include="src/Model/Content.fs" />
    <Compile Include="src/Model/Document.fs" />
    <Compile Include="src/Conversion/Conversion.fs" />
    <Compile Include="src/Conversion/Registry.fs" />
    <Compile Include="src/Formats/PlainText.fs" />
    <Compile Include="src/Formats/Markdown.fs" />
    <Compile Include="src/Formats/Html.fs" />
    <Compile Include="src/Formats/Pdf.fs" />
    <Compile Include="src/Formats/OpenXml.fs" />
    <Compile Include="src/Formats/Formats.fs" />
  </ItemGroup>

</Project>
