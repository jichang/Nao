<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Source-backed knowledge, provenance, citation, and retrieval contracts for Nao.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/KnowledgeContracts.fs" />
    <Compile Include="src/KnowledgeCatalog.fs" />
    <Compile Include="src/SourceConnector.fs" />
    <Compile Include="src/SourcePath.fs" />
    <Compile Include="src/SourceChanges.fs" />
    <Compile Include="src/FilesystemSourceCheckpoint.fs" />
    <Compile Include="src/FilesystemSourceConnector.fs" />
    <Compile Include="src/HttpSourceContracts.fs" />
    <Compile Include="src/HttpSourceCheckpoint.fs" />
    <Compile Include="src/HttpSourceConnector.fs" />
    <Compile Include="src/GitSourceContracts.fs" />
    <Compile Include="src/GitSourceCheckpoint.fs" />
    <Compile Include="src/GitSourceConnector.fs" />
    <Compile Include="src/SourceResilienceContracts.fs" />
    <Compile Include="src/SourceFailureStore.fs" />
    <Compile Include="src/SourceSynchronizationRunner.fs" />
    <Compile Include="src/ParserContracts.fs" />
    <Compile Include="src/ParserRegistry.fs" />
    <Compile Include="src/TextNormalization.fs" />
    <Compile Include="src/PlainTextParser.fs" />
    <Compile Include="src/JsonParser.fs" />
    <Compile Include="src/KnowledgeParsingService.fs" />
    <Compile Include="src/ChunkingContracts.fs" />
    <Compile Include="src/StructureAwareChunker.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nao.Agents\Nao.Agents.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
