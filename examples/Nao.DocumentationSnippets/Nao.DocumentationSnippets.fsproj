<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/AgentSnippet.fs" />
    <Compile Include="src/ConfigurationSnippet.fs" />
    <Compile Include="src/AdapterSnippet.fs" />
    <Compile Include="src/Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Nao.Agents/Nao.Agents.fsproj" />
    <ProjectReference Include="../../src/Nao.Extensions/Nao.Extensions.fsproj" />
    <ProjectReference Include="../../src/Nao.Platform/Nao.Platform.fsproj" />
  </ItemGroup>
  <Import Project="../../.paket/Paket.Restore.targets" />
</Project>
